---
import BaseHead from "../../components/BaseHead.astro";
import PageLayout from "../../layouts/PageLayout.astro";

type Setting = {
  result: string;
  // A single temperature or a range, in °F, e.g. "140" or "129–134".
  temp: string;
  time: string;
  recommended?: boolean;
};

type Food = {
  name: string;
  note?: string;
  source: string;
  settings: Setting[];
};

type Group = {
  title: string;
  foods: Food[];
};

// Numbers follow Serious Eats' Food Lab guides, linked from each food.
const groups: Group[] = [
  {
    title: "Steak",
    foods: [
      {
        name: "Ribeye, strip, sirloin",
        note: "Times are for 1½–2\" steaks; 1\" or thinner can come out after 40 min. Keep medium-rare under 130°F to 2½ hr max.",
        source: "https://www.seriouseats.com/food-lab-complete-guide-to-sous-vide-steak",
        settings: [
          { result: "Rare", temp: "120–128", time: "1–2½ hr" },
          { result: "Medium-rare", temp: "129–134", time: "1–4 hr", recommended: true },
          { result: "Medium", temp: "135–144", time: "1–4 hr" },
          { result: "Medium-well", temp: "145–155", time: "1–3½ hr" },
          { result: "Well-done", temp: "156+", time: "1–3 hr" },
        ],
      },
      {
        name: "Filet (tenderloin)",
        note: "Lean, so it's best on the rare side. Times are for 1½–2\" steaks; 1\" or thinner can come out after 30 min.",
        source: "https://www.seriouseats.com/food-lab-complete-guide-to-sous-vide-steak",
        settings: [
          { result: "Rare", temp: "120–128", time: "45 min–2½ hr", recommended: true },
          { result: "Medium-rare", temp: "129–134", time: "45 min–4 hr" },
          { result: "Medium", temp: "135–144", time: "45 min–4 hr" },
          { result: "Medium-well", temp: "145–155", time: "45 min–3½ hr" },
          { result: "Well-done", temp: "156+", time: "1–3 hr" },
        ],
      },
    ],
  },
  {
    title: "Chicken",
    foods: [
      {
        name: "Breast",
        source: "https://www.seriouseats.com/the-food-lab-complete-guide-to-sous-vide-chicken-breast",
        settings: [
          { result: "Very soft and juicy", temp: "140", time: "1½–4 hr", recommended: true },
          { result: "Tender, juicy; great cold", temp: "150", time: "1–4 hr" },
          { result: "Traditional, firm", temp: "160", time: "1–4 hr" },
        ],
      },
      {
        name: "Thighs",
        source: "https://www.seriouseats.com/crispy-sous-vide-chicken-thigh-recipe",
        settings: [
          { result: "Very juicy, quite firm", temp: "150", time: "1–4 hr" },
          { result: "Juicy, completely tender", temp: "165", time: "1–4 hr", recommended: true },
          { result: "Falls off the bone", temp: "165", time: "4–8 hr" },
        ],
      },
    ],
  },
  {
    title: "Pork",
    foods: [
      {
        name: "Chops",
        source: "https://www.seriouseats.com/sous-vide-pork-chops-recipe",
        settings: [
          { result: "Rare", temp: "130", time: "1–4 hr" },
          { result: "Medium-rare", temp: "140", time: "1–4 hr", recommended: true },
          { result: "Medium-well", temp: "150", time: "1–4 hr" },
          { result: "Well-done", temp: "160", time: "1–4 hr" },
        ],
      },
      {
        name: "Tenderloin",
        source: "https://www.seriouseats.com/sous-vide-pork-tenderloin-recipe",
        settings: [
          { result: "Medium-rare", temp: "130", time: "1–4 hr" },
          { result: "Medium", temp: "140", time: "1–4 hr", recommended: true },
          { result: "Medium-well", temp: "150", time: "1–4 hr" },
          { result: "Well-done", temp: "160", time: "1–4 hr" },
        ],
      },
      {
        name: "Shoulder",
        source: "https://www.seriouseats.com/sous-vide-carnitas-crispy-mexican-style-pulled-pork-recipe",
        settings: [
          { result: "Tender slabs, not shreddable", temp: "145", time: "24–36 hr" },
          { result: "Easy to shred", temp: "165", time: "12–24 hr", recommended: true },
          { result: "Traditional pulled", temp: "185", time: "8–16 hr" },
        ],
      },
    ],
  },
];
---

<PageLayout>
  <BaseHead
    title="Sous Vide Times & Temps | Travis Northcutt"
    description="Sous vide times and temperatures for steak, chicken, and pork."
    slot="meta"
  />
  <Fragment slot="main">
    <p class="back"><a href="/tools">&larr; Tools</a></p>
    <h1 class="text-3xl font-bold text-center">Sous vide times &amp; temps</h1>
    <p>
      Times and temps from Serious Eats' Food Lab guides. <span class="pick">★</span>&nbsp;marks a
      good default.
    </p>

    <nav class="jump" aria-label="Jump to section">
      {groups.map((group) => <a href={`#${group.title.toLowerCase()}`}>{group.title}</a>)}
    </nav>

    {
      groups.map((group) => (
        <section id={group.title.toLowerCase()}>
          <h2>{group.title}</h2>
          {group.foods.map((food) => (
            <div class="food">
              <h3>{food.name}</h3>
              {food.note && <p class="note">{food.note}</p>}
              <table>
                <thead>
                  <tr>
                    <th scope="col">Result</th>
                    <th scope="col" class="num">Temp</th>
                    <th scope="col" class="num">Time</th>
                  </tr>
                </thead>
                <tbody>
                  {food.settings.map((setting) => (
                    <tr class:list={{ recommended: setting.recommended }}>
                      <td>
                        {setting.result}
                        {setting.recommended && (
                          <span class="pick" aria-label="recommended"> ★</span>
                        )}
                      </td>
                      <td class="num temp">{setting.temp}°F</td>
                      <td class="num">{setting.time}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="source">
                <a href={food.source}>Source</a>
              </p>
            </div>
          ))}
        </section>
      ))
    }
  </Fragment>
</PageLayout>

<style>
  .back {
    margin-bottom: 0;
    font-size: 1rem;
  }

  .jump {
    display: flex;
    gap: 1rem;
    font-size: 1rem;
  }

  h2 {
    border-bottom: 1px solid var(--color-base-150);
    padding-bottom: 0.25rem;
  }

  .food h3 {
    margin-bottom: 0.25rem;
  }

  .note {
    margin: 0 0 0.5rem;
    color: var(--color-base-600);
    font-size: 1rem;
  }

  .source {
    margin: 0.25rem 0 0;
    text-align: right;
    font-size: 0.85rem;
  }

  /* Fixed layout keeps the columns aligned from one table to the next. */
  table {
    margin-top: 0.5rem;
    font-size: 1.05rem;
    table-layout: fixed;
  }

  th:nth-child(2) {
    width: 7.5rem;
  }

  th:nth-child(3) {
    width: 7rem;
  }

  th {
    color: var(--color-base-600);
    font-weight: normal;
    font-size: 0.9rem;
  }

  .num {
    text-align: right;
  }

  .temp {
    white-space: nowrap;
    font-weight: bold;
    font-size: 1.2rem;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 480px) {
    th:nth-child(2) {
      width: 5.5rem;
    }

    th:nth-child(3) {
      width: 5rem;
    }

    table {
      font-size: 0.95rem;
    }

    .temp {
      font-size: 1rem;
    }
  }

  tr.recommended td {
    background: var(--color-base-50);
  }

  .pick {
    color: var(--color-orange);
  }
</style>
