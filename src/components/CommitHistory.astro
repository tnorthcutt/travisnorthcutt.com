---
type Props = {
  path: string;
};
const GITHUB_API_TOKEN = import.meta.env.GITHUB_API_TOKEN;

let { path } = Astro.props;
path = path.startsWith("/") ? path.slice(1) : path;
path = path.replace(/\//g, ""); // This will remove all forward slashes

const base =
  "https://api.github.com/repos/tnorthcutt/travisnorthcutt.com/commits?path=src/content/blog/";

const headers = {
  Authorization: `token ${GITHUB_API_TOKEN}`,
};

const response = await fetch(base + path, { headers });
const data = await response.json();

// The avatar renders at 64px CSS (h-16/w-16), so 128px covers 2x displays.
// GitHub serves the full 460x460 original unless we ask for a size.
const AVATAR_SIZE = 128;
const avatarUrl = (url?: string) =>
  url ? `${url}${url.includes("?") ? "&" : "?"}s=${AVATAR_SIZE}` : undefined;
---

<h2>Revisions</h2>
<div class="space-y-4">
  {
    data?.length > 0 && data.map((commit) => (
      <div class="flex border-solid border border-gray-300 p-4">
        {commit.author?.avatar_url && (
          <img
            class="my-0 h-16 w-16 rounded-full"
            src={avatarUrl(commit.author.avatar_url)}
            alt={`${commit.commit.author.name}'s avatar`}
            width={AVATAR_SIZE}
            height={AVATAR_SIZE}
            loading="lazy"
            decoding="async"
          />
        )}
        <div class="flex flex-col px-4">
          <>
            <a
              class="bg-none"
              href={commit.html_url}
              target="gh-history"
            >
              {commit.commit.message.split()[0]}
            </a>
            <span>
              {commit.commit.author.name} updated this on
              {new Date(commit.commit.author.date).toLocaleDateString()}
            </span>
          </>
        </div>
      </div>
    ))
  }
</div>
